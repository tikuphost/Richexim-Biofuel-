# Environment Configuration Template for Richmount Exim Portal

# Server Port (Defaults to 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Google Gemini API Key (Optional / server-side AI assist features)
GEMINI_API_KEY=

# Public Application URL (Used for canonical links, webhooks, and SEO)
APP_URL=http://localhost:3000
